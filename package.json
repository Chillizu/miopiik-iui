{
  "name": "miopiik-iui",
  "version": "0.1.0-rc.15",
  "type": "module",
  "description": "MiOpIIk IUI — trusted native Markdown embeds for DeepSeek Harness",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test",
    "check": "node tools/check-release.mjs",
    "build:check": "node tools/build.mjs --check",
    "icon:check": "node tools/icon-check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "index.js",
    "client.js",
    "renderer.js",
    "settings.js",
    "shared/",
    "patches/",
    "locale/*.json",
    "cordis.patch.yml",
    "tools/build.mjs",
    "tools/fork-chat-embeds.mjs",
    "tools/install-plugin.mjs",
    "tools/check-release.mjs",
    "tools/icon-check.mjs",
    "tools/verify-pack.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "miopiik",
    "iui",
    "markdown",
    "declarative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chillizu/miopiik-iui.git"
  },
  "homepage": "https://github.com/Chillizu/miopiik-iui#readme",
  "bugs": {
    "url": "https://github.com/Chillizu/miopiik-iui/issues"
  }
}
